{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "functions": {
    "api/properties.ts": {
      "includeFiles": "data/properties.json"
    },
    "api/testimonials.ts": {
      "includeFiles": "data/testimonials.json"
    }
  },
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/listings",
      "destination": "/listings.html"
    },
    {
      "source": "/resources",
      "destination": "/resources.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/disclosure",
      "destination": "/disclosure.html"
    },
    {
      "source": "/((?!api/|sitemap\\.xml|robots\\.txt|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
