{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "functions": {
    "api/properties.ts": {
      "includeFiles": "data/properties.json"
    },
    "api/testimonials.ts": {
      "includeFiles": "data/testimonials.json"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|sitemap\\.xml|robots\\.txt|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
